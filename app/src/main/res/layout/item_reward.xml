<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/rewardNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reward Name"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rewardDescriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reward Description"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/requiredPointsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Required Points"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/rewardStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textSize="14sp" />

    <Button
        android:id="@+id/claimRewardButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claim Reward" />

</LinearLayout>
